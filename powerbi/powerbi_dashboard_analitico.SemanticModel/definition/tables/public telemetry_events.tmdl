table 'public telemetry_events'
	lineageTag: 94a9856b-fc2e-4635-b564-3194f24818e3

	measure 'Consumo Total' = SUM('public telemetry_events'[meter_reading])
		lineageTag: 957ab0e6-0a29-491c-9eab-bfa46ea6603d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Consumo por m2' = DIVIDE([Consumo Total], SUM('public buildings'[square_meters]))
		lineageTag: ad8b8bf0-7f4a-40db-8aea-15a457ea0a00

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Anomalias' = SUM('public telemetry_events'[Es Anomalia])
		formatString: 0
		lineageTag: 99390f0d-ca94-4427-8652-2177fe220613

	measure 'Total Edificios' = DISTINCTCOUNT('public telemetry_events'[building_id])
		formatString: 0
		lineageTag: 6245f7c5-999b-4b22-96ba-4af76813a510

