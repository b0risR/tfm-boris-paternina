	column baseline_p75
		dataType: double
		sourceProviderType: double
		lineageTag: 86fd645a-ff6d-47db-bb33-d532e67a9380
		summarizeBy: none
		sourceColumn: baseline_p75

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column baseline_iqr
		dataType: double
		sourceProviderType: double
		lineageTag: 02ad8ff8-02f9-4354-a5f4-3cb29411fb45
		summarizeBy: none
		sourceColumn: baseline_iqr

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Limite Superior' = 'public telemetry_events'[baseline_p75] + 1.5 * 'public telemetry_events'[baseline_iqr]
		lineageTag: 7bd07993-416b-4069-8a5b-5eef57f97544
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Limite Inferior' = 'public telemetry_events'[baseline_p25] - 1.5 * 'public telemetry_events'[baseline_iqr]
		lineageTag: efa10c77-bdaf-4399-8597-3914acb30ddf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Es Anomalia' =
			
			IF(
			    ISBLANK('public telemetry_events'[baseline_p75])
			        || 'public telemetry_events'[baseline_iqr] = 0,
			    BLANK(),
			    IF(
			        'public telemetry_events'[meter_reading] > 'public telemetry_events'[baseline_p75] + 5 * 'public telemetry_events'[baseline_iqr],
			        1, 0
			    )
			)
		formatString: 0
		lineageTag: 35bdd956-4c11-4200-b060-c8c150adc1ff
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

