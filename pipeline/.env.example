# Plantilla de credenciales locales. Renombra este archivo a .env
# antes de ejecutar el pipeline.
#
# Lo lee Docker Compose automaticamente (variables ${...} en
# docker-compose.yml) y los scripts Python via common/conexion.py
#
# Son credenciales de desarrollo local, no secretos: el stack no se
# expone fuera de la maquina.

POSTGRES_USER=tfm
POSTGRES_PASSWORD=developer
TIMESCALE_USER=tfm
TIMESCALE_PASSWORD=developer

# NOTA: las datasources de Grafana provisionadas y
# tools/demo.py llevan este nombre; si se renombra aqui, hay
# que editarlas tambien.
TIMESCALE_PORT=5432
TIMESCALE_DB=tfm_metrics
POSTGRES_PORT=5433
POSTGRES_DB=tfm_analytics

KAFKA_EXTERNAL_PORT=29092

KAFKA_TOPIC_RAW=iot.telemetry.raw
KAFKA_TOPIC_DLQ=iot.telemetry.dlq

# Particiones y factor de replica de los topicos. El broker los aplica como
# default al auto-crear un topico; reset_state.py los usa al recrearlos para
# una medicion. Un solo broker => el factor de replica solo puede ser 1.
KAFKA_NUM_PARTITIONS=3
KAFKA_DEFAULT_REPLICATION_FACTOR=1

# Grupo de suscripcion compartida del bridge. Poner BRIDGE_SHARED_GROUP=bridge-pool
# SOLO al escalar (docker compose up -d --scale bridge=N), que activa $share/ para
# repartir la carga entre las N replicas.
BRIDGE_SHARED_GROUP=

# Aqui Spark (stream_processing.py) encuentra los servicios cuando
# corre en el HOST.
SPARK_KAFKA_BOOTSTRAP=localhost:29092
SPARK_PG_HOST=localhost
SPARK_PG_PORT=5433
SPARK_TS_HOST=localhost
SPARK_TS_PORT=5432
